---
import MaxLayout from '../layouts/MaxLayout.astro';
---

<MaxLayout title="Max Content Deck">
  <!-- Outer vertical stack container -->
  <section>
    
    

    <!-- Page 2 -->
    <section style="background-color: #1a1e24; color: #e2e8f0; height: 100%; display: flex; flex-direction: column; padding: 0.5rem; box-sizing: border-box;">
      <h2 style="color: #60a5fa;">01. Top Section - Dense Overview</h2>
      <p>PAGE 2: Data payload running at minimum threshold scale with edge-to-edge layout bounds.</p>
      
      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem; font-size: 0.75rem; margin-top: 0.25rem;">
        <div style="background: rgba(255,255,255,0.05); padding: 0.4rem; border-radius: 2px;">
          <strong>Metric A: this can be little long description.</strong>
          <ul style="font-size: 0.7rem; margin-top: 0.2rem;">
            <li>High throughput pipeline execution</li>
            <li>Zero margin configuration active</li>
            <li>Direct CSS viewport override</li>
          </ul>
        </div>
        <div style="background: rgba(255,255,255,0.05); padding: 0.4rem; border-radius: 2px;">
          <strong>Metric B: this can be little long description.</strong>
          <ul style="font-size: 0.7rem; margin-top: 0.2rem;">
            <li>Component density maximized</li>
            <li>Padding collapsed to 0.5rem</li>
            <li>Flex layout distribution</li>
          </ul>
        </div>
        <div style="background: rgba(255,255,255,0.05); padding: 0.4rem; border-radius: 2px;">
          <strong>Metric C: this can be little long description.</strong>
          <ul style="font-size: 0.7rem; margin-top: 0.2rem;">
            <li>Custom reveal initialization</li>
            <li>Viewport width 100% force</li>
            <li>Scale bounds fixed at 1.0</li>
          </ul>
        </div>
      </div>
    </section>

    

  </section>
</MaxLayout>

